# Copy to .env.local (local) and add the same names in Vercel > Project > Settings > Environment Variables.
# NEVER commit real values. Placeholders only.

# Public: safe in the browser (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# SERVER ONLY: never prefix with NEXT_PUBLIC_. Used solely to store contact enquiries.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Contact-form email notifications (optional but recommended): https://resend.com
RESEND_API_KEY=your-resend-api-key
CONTACT_TO_EMAIL=youthcareerhubtanzania@gmail.com
CONTACT_FROM_EMAIL="YCH Website <onboarding@resend.dev>"

# Random string (e.g. `openssl rand -hex 24`) used to hash visitor IPs for rate limiting
IP_HASH_SALT=change-me-to-a-long-random-string
